# Application
MOK_APP_NAME=mok
MOK_DEBUG=true
MOK_LOG_LEVEL=INFO
MOK_FRONTEND_URL=http://localhost:3000

# Database
MOK_DATABASE_URL=postgresql+asyncpg://mok:mok@localhost:5432/mok

# JWT — REPLACE IN PRODUCTION
MOK_JWT_SECRET_KEY=dev-secret-change-in-production
MOK_JWT_ALGORITHM=HS256
MOK_JWT_EXPIRATION_MINUTES=480

# Initial admin seeding (first boot only)
MOK_INITIAL_ADMIN_EMAIL=admin@mok.dev
# Leave blank to auto-generate a one-time password printed to the log
MOK_INITIAL_ADMIN_PASSWORD=

# Password policy
MOK_PASSWORD_MIN_LENGTH=8
MOK_PASSWORD_REQUIRE_UPPERCASE=true
MOK_PASSWORD_REQUIRE_LOWERCASE=true
MOK_PASSWORD_REQUIRE_DIGIT=true

# LLM providers (set the ones you intend to use)
MOK_ANTHROPIC_API_KEY=
MOK_OPENAI_API_KEY=
MOK_GEMINI_API_KEY=
MOK_OLLAMA_BASE_URL=http://localhost:11434
MOK_DEFAULT_MODEL=anthropic:claude-sonnet-4-6

# SMTP (leave blank to log emails to stdout in dev)
MOK_SMTP_HOST=
MOK_SMTP_PORT=587
MOK_SMTP_USER=
MOK_SMTP_PASSWORD=
MOK_SMTP_FROM=

# Contact form recipient (where /contact submissions go)
MOK_CONTACT_RECIPIENT=admin@mok.dev
